# Copier vers .env.local et remplir. Ne jamais committer .env.local.
#
# Aucune valeur réelle ne doit figurer dans ce fichier : il est versionné.
# Sans les variables Supabase, l'application bascule sur le dépôt en mémoire
# et l'annonce dans l'interface.

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
SUPABASE_URL=

# Clé « service_role » — Supabase → Project Settings → API Keys → service_role
#
# ⚠️ Contourne RLS et donne un accès total. Jamais dans du code client, jamais
# dans un NEXT_PUBLIC_*, jamais dans git (cahier §102).
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application. Sert à construire les liens des e-mails ;
# sans elle ils pointent vers http://localhost:3000.
APP_URL=

# Origines acceptées pour les actions serveur (protection CSRF).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Chiffrement des secrets MFA (cahier §86)
# ---------------------------------------------------------------------------
# Chiffre les secrets TOTP au repos (AES-256-GCM, clé dérivée par scrypt).
#
# ⚠️ NE JAMAIS LA REGÉNÉRER SUR UN ENVIRONNEMENT EXISTANT : les secrets déjà
# chiffrés deviendraient illisibles et tous les comptes MFA seraient bloqués.
# La perdre a le même effet. À conserver dans le gestionnaire de secrets de
# l'hébergeur, pas seulement dans .env.local. Voir docs/mfa.md.
#
# Générer (nouvel environnement uniquement) :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# E-mail
# ---------------------------------------------------------------------------
# development | live
# Tout ce qui n'est pas « live » journalise les messages sans les envoyer.
# C'est ce qui empêche un environnement de recette d'écrire à de vrais joueurs.
EMAIL_MODE=development

# Seul « resend » est implémenté. Voir src/lib/email/provider.ts.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Grand Line Weekly <no-reply@exemple.fr>
EMAIL_REPLY_TO=

# ---------------------------------------------------------------------------
# Connexion Google (OpenID Connect)
# ---------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type « Web application »).
#
# URI de redirection autorisée a declarer chez Google :
#   https://<ton-domaine>/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback   (developpement)
#
# Sans ces deux variables, le bouton « Continuer avec Google » n'apparait pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Tâches planifiées
# ---------------------------------------------------------------------------
# Sur Vercel, la plateforme envoie CRON_SECRET automatiquement en
# `Authorization: Bearer`. Le nom est impose par elle.
CRON_SECRET=

# Jeton porteur pour un declencheur externe (GitHub Actions, cron systeme) ou
# un appel manuel. Sans CRON_SECRET ni JOB_SECRET, /api/jobs/* repond 503.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOB_SECRET=

# ---------------------------------------------------------------------------
# Paiements — NON ACTIVÉS
# ---------------------------------------------------------------------------
# ⚠️ Laisser à « false ». L'activation reste suspendue à l'audit juridique
# (§122) et aux obligations de protection des mineurs (§114).
PAYMENTS_ENABLED=false

# test | live. En production, « live » avec une clé sk_test_ est refusé au
# démarrage : un paiement fictif ne doit jamais créditer un vrai compte.
PAYMENT_MODE=test
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Chapter HQ — administration (cahier §86)
# ---------------------------------------------------------------------------
# Adresse du SEUL compte autorisé à ouvrir /admin.
#
# Second verrou, indépendant de la base : le rôle ADMIN reste nécessaire, mais
# il ne suffit plus. Il vit dans une colonne, donc à portée d'une restauration
# de sauvegarde ou d'un update en console ; cette variable, elle, vit chez
# l'hébergeur. Il faut compromettre les deux, par deux chemins différents.
#
# Vide, le rôle décide seul — acceptable en développement, signalé en
# production par la vérification d'environnement.
ADMIN_EMAIL=
